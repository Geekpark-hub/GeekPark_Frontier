.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding: 14rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: #f7f5f1;
  box-sizing: border-box;
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0 4rpx;
  transition: opacity 0.18s ease;
}

.item:active {
  opacity: 0.7;
}

.icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.label {
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 1rpx;
  color: #a8a096;
  font-weight: 400;
  transition: color 0.18s ease;
}

.item.on .label {
  color: #14202b;
  font-weight: 500;
}
