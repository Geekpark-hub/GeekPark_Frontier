.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  min-height: 112rpx;
  padding: 14rpx 8rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #f7f5f1;
  box-sizing: border-box;
}

.tabbar.is-hidden {
  display: none;
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rpx 0;
}

.item:active {
  opacity: 0.75;
}

.icon-box {
  position: relative;
  overflow: hidden;
  margin-bottom: 6rpx;
}

.icon-img {
  display: block;
  position: relative;
  z-index: 1;
}

.icon-canvas {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  display: block;
}

.label {
  font-size: 22rpx;
  line-height: 1.25;
  letter-spacing: 1rpx;
  color: #a8a096;
  font-weight: 400;
}

.item.on .label {
  color: #14202b;
  font-weight: 560;
}
