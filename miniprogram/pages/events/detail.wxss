.detail {
  padding-bottom: 48rpx;
}

.cover-wrap {
  margin: 0 0 28rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #ebe6dc;
}

.cover {
  display: block;
  width: 100%;
  height: auto;
  vertical-align: top;
}

.title {
  font-size: 40rpx;
  font-weight: 650;
  line-height: 1.35;
  color: #14202b;
  margin-bottom: 16rpx;
}

.meta-line {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6d7883;
}

.meta-line.is-link {
  color: #14202b;
  text-decoration: underline;
  text-decoration-color: rgba(20, 32, 43, 0.22);
  text-underline-offset: 4rpx;
}

.meta-line.accent {
  color: #14202b;
  font-weight: 500;
}

.block {
  margin-top: 36rpx;
}

.label {
  font-size: 22rpx;
  color: #9a9286;
  margin-bottom: 14rpx;
  letter-spacing: 2rpx;
}

.text {
  white-space: pre-wrap;
  line-height: 1.75;
  color: #243447;
  font-size: 28rpx;
}

.line-list {
  background: #fff;
  border: 1rpx solid rgba(20, 32, 43, 0.08);
  border-radius: 12rpx;
  padding: 4rpx 8rpx 4rpx 18rpx;
}

.line-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 16rpx;
  border-bottom: 1rpx solid rgba(20, 32, 43, 0.06);
  font-size: 28rpx;
  line-height: 1.55;
  color: #243447;
}

.line-item:last-child {
  border-bottom: none;
}

.line-item .dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: #14202b;
  flex-shrink: 0;
}

.status-chip {
  display: inline-block;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(20, 32, 43, 0.18);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #14202b;
}

.reg-card {
  background: #fff;
  border: 1rpx solid rgba(20, 32, 43, 0.1);
  border-radius: 16rpx;
  padding: 28rpx 28rpx 20rpx;
  box-sizing: border-box;
}

.reg-card-main {
  padding-left: 20rpx;
  border-left: 4rpx solid #14202b;
}

.reg-status {
  font-size: 30rpx;
  font-weight: 500;
  color: #14202b;
  letter-spacing: 1rpx;
}

.reg-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8378;
  line-height: 1.4;
}

.reg-cancel {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(20, 32, 43, 0.08);
  font-size: 24rpx;
  color: #8a8378;
  letter-spacing: 2rpx;
  text-align: center;
}

.reg-hint {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(20, 32, 43, 0.08);
  font-size: 22rpx;
  color: #9a9286;
  text-align: center;
}

.form-item {
  margin-bottom: 18rpx;
}

.form-label {
  font-size: 22rpx;
  color: #8a8378;
  margin-bottom: 10rpx;
}

.input,
.textarea,
.picker {
  background: #fff;
  border: 1rpx solid rgba(20, 32, 43, 0.1);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #14202b;
  min-height: 88rpx;
}

.textarea {
  min-height: 180rpx;
}

.submit {
  margin-top: 12rpx;
}

.done {
  margin-top: 40rpx;
  padding: 28rpx;
  text-align: center;
  color: #8a8378;
  font-size: 24rpx;
}

.state {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-text {
  color: #8a8378;
  font-size: 26rpx;
}

.state-action {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #14202b;
  letter-spacing: 2rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(20, 32, 43, 0.16);
  border-radius: 999rpx;
}

.press {
  opacity: 0.65;
}
