.events-page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tabs {
  display: flex;
  gap: 36rpx;
  margin-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(20, 32, 43, 0.1);
}

.tab {
  padding: 8rpx 0 18rpx;
  color: #8a8378;
  font-size: 28rpx;
  letter-spacing: 1rpx;
  border-bottom: 3rpx solid transparent;
  margin-bottom: -1rpx;
}

.tab.on {
  color: #14202b;
  font-weight: 600;
  border-bottom-color: #14202b;
}

.cover-card {
  position: relative;
  height: 380rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #1a1a1a;
}

.cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.cover-veil {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.72) 100%);
}

.cover-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx;
  z-index: 1;
}

.cover-tag {
  display: inline-block;
  margin-bottom: 12rpx;
  padding: 4rpx 12rpx;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 8rpx;
}

.cover-title {
  font-size: 34rpx;
  font-weight: 650;
  color: #fff;
  line-height: 1.35;
}

.cover-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.press {
  opacity: 0.92;
}

.empty {
  padding: 48rpx 0 80rpx;
  text-align: center;
}

.collage {
  position: relative;
  height: 260rpx;
  margin: 0 auto 24rpx;
  width: 86%;
}

.collage .c {
  position: absolute;
  width: 200rpx;
  height: 230rpx;
  border-radius: 12rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.16);
  background: #ddd;
}

.collage .c1 {
  left: 6%;
  top: 24rpx;
  transform: rotate(-8deg);
  z-index: 1;
}

.collage .c2 {
  left: 34%;
  top: 0;
  transform: rotate(2deg);
  z-index: 3;
  width: 220rpx;
}

.collage .c3 {
  right: 4%;
  top: 28rpx;
  transform: rotate(9deg);
  z-index: 2;
}

.empty-text {
  color: #8a8378;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}
