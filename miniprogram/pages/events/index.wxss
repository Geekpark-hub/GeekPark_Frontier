.events-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tabs {
  display: flex;
  gap: 36rpx;
  margin-bottom: 28rpx;
  border-bottom: 1rpx solid rgba(20, 32, 43, 0.1);
}

.tab {
  padding: 8rpx 0 18rpx;
  color: #8a8378;
  font-size: 28rpx;
  letter-spacing: 1rpx;
  border-bottom: 3rpx solid transparent;
  margin-bottom: -1rpx;
}

.tab.on {
  color: #14202b;
  font-weight: 600;
  border-bottom-color: #14202b;
}

/* 上图下文：海报完整展示，信息不压图 */
.event-card {
  margin-bottom: 28rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 6rpx 24rpx rgba(20, 32, 43, 0.06);
}

.event-cover {
  position: relative;
  background: #ebe6dc;
}

.cover-img {
  display: block;
  width: 100%;
  height: auto;
  vertical-align: top;
}

.cover-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 6rpx 14rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #fff;
  background: rgba(20, 32, 43, 0.72);
  border-radius: 8rpx;
}

.event-body {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 28rpx 30rpx;
}

.event-main {
  flex: 1;
  min-width: 0;
}

.event-status {
  display: inline-block;
  margin-bottom: 10rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #14202b;
  background: #ebe6dc;
  border-radius: 8rpx;
}

.event-title {
  font-size: 36rpx;
  font-weight: 650;
  color: #14202b;
  line-height: 1.4;
}

.event-meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6d7883;
  line-height: 1.45;
}

/* 右侧轻箭头，提示可点进详情 */
.event-arrow {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  margin-right: 4rpx;
  border-right: 3rpx solid rgba(20, 32, 43, 0.28);
  border-top: 3rpx solid rgba(20, 32, 43, 0.28);
  transform: rotate(45deg);
}

.press {
  opacity: 0.92;
}

.empty {
  padding: 48rpx 0 80rpx;
  text-align: center;
}

.collage {
  position: relative;
  height: 260rpx;
  margin: 0 auto 24rpx;
  width: 86%;
}

.collage .c {
  position: absolute;
  width: 200rpx;
  height: 230rpx;
  border-radius: 12rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.16);
  background: #ddd;
}

.collage .c1 {
  left: 6%;
  top: 24rpx;
  transform: rotate(-8deg);
  z-index: 1;
}

.collage .c2 {
  left: 34%;
  top: 0;
  transform: rotate(2deg);
  z-index: 3;
  width: 220rpx;
}

.collage .c3 {
  right: 4%;
  top: 28rpx;
  transform: rotate(9deg);
  z-index: 2;
}

.empty-text {
  color: #8a8378;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}
