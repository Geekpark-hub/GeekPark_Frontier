.share-page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f7f5f1;
}

.hero {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
  background: #14202b;
}

.hero-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-veil {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(20, 32, 43, 0.15) 0%,
    rgba(20, 32, 43, 0.55) 55%,
    rgba(20, 32, 43, 0.78) 100%
  );
}

.hero-brand {
  position: absolute;
  left: 36rpx;
  bottom: 36rpx;
  right: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.brand-en {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.72);
}

.brand-zh {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 4rpx;
}

.body {
  padding: 36rpx 32rpx 0;
}

.eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #9a9286;
  margin-bottom: 12rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 650;
  line-height: 1.35;
  color: #14202b;
}

.meta-list {
  margin-top: 28rpx;
  padding: 8rpx 0;
  border-top: 1rpx solid rgba(20, 32, 43, 0.08);
  border-bottom: 1rpx solid rgba(20, 32, 43, 0.08);
}

.meta-row {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
}
.meta-row.is-link .meta-v {
  color: #14202b;
  text-decoration: underline;
  text-decoration-color: rgba(20, 32, 43, 0.22);
  text-underline-offset: 4rpx;
}

.meta-k {
  width: 64rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9a9286;
  letter-spacing: 2rpx;
}

.meta-v {
  flex: 1;
  font-size: 26rpx;
  color: #243447;
  line-height: 1.45;
}

.block {
  margin-top: 36rpx;
}

.label {
  font-size: 22rpx;
  color: #9a9286;
  margin-bottom: 14rpx;
  letter-spacing: 2rpx;
}

.text {
  white-space: pre-wrap;
  line-height: 1.75;
  color: #243447;
  font-size: 28rpx;
}

.line-list {
  background: #fff;
  border: 1rpx solid rgba(20, 32, 43, 0.08);
  border-radius: 12rpx;
  padding: 4rpx 8rpx 4rpx 18rpx;
}

.line-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 16rpx;
  border-bottom: 1rpx solid rgba(20, 32, 43, 0.06);
  font-size: 28rpx;
  line-height: 1.55;
  color: #243447;
}

.line-item:last-child {
  border-bottom: none;
}

.line-item .dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: #14202b;
  flex-shrink: 0;
}

.status-chip {
  display: inline-block;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(20, 32, 43, 0.18);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #14202b;
}

.reg-card {
  background: #fff;
  border: 1rpx solid rgba(20, 32, 43, 0.1);
  border-radius: 16rpx;
  padding: 28rpx 28rpx 20rpx;
  box-sizing: border-box;
}

.reg-card-main {
  padding-left: 20rpx;
  border-left: 4rpx solid #14202b;
}

.reg-status {
  font-size: 30rpx;
  font-weight: 500;
  color: #14202b;
  letter-spacing: 1rpx;
}

.reg-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8378;
  line-height: 1.4;
}

.reg-cancel {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(20, 32, 43, 0.08);
  font-size: 24rpx;
  color: #8a8378;
  letter-spacing: 2rpx;
  text-align: center;
}

.reg-hint {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(20, 32, 43, 0.08);
  font-size: 22rpx;
  color: #9a9286;
  text-align: center;
}

.form-item {
  margin-bottom: 18rpx;
}

.form-label {
  font-size: 22rpx;
  color: #8a8378;
  margin-bottom: 10rpx;
}

.input,
.textarea {
  background: #fff;
  border: 1rpx solid rgba(20, 32, 43, 0.1);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #14202b;
  min-height: 88rpx;
}

.textarea {
  min-height: 180rpx;
}

.submit {
  margin-top: 12rpx;
}

.done {
  margin-top: 40rpx;
  padding: 28rpx;
  text-align: center;
  color: #8a8378;
  font-size: 24rpx;
}

.state {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.state-text {
  color: #8a8378;
  font-size: 26rpx;
}

.state-action {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #14202b;
  letter-spacing: 2rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(20, 32, 43, 0.16);
  border-radius: 999rpx;
}

.press {
  opacity: 0.65;
}
