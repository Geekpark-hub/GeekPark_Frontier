.share-page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f7f5f1;
}

.top {
  padding: 48rpx 36rpx 32rpx;
  background: linear-gradient(180deg, #ebe6dc 0%, #f7f5f1 100%);
}

.brand-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 36rpx;
}

.brand-en {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #9a9286;
}

.brand-bar {
  color: rgba(20, 32, 43, 0.25);
  font-size: 20rpx;
}

.brand-zh {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: #14202b;
}

.eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #9a9286;
  margin-bottom: 12rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 650;
  line-height: 1.35;
  color: #14202b;
}

.desc {
  margin-top: 18rpx;
  color: #243447;
  line-height: 1.7;
  font-size: 28rpx;
}

.meta {
  margin-top: 16rpx;
  color: #6d7883;
  font-size: 24rpx;
}

.body {
  padding: 8rpx 32rpx 0;
}

.options {
  margin-top: 12rpx;
}

.option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border: 1rpx solid rgba(20, 32, 43, 0.1);
  border-radius: 14rpx;
}

.option.on {
  border-color: #14202b;
  background: #eef2f5;
}

.option.disabled {
  opacity: 0.9;
}

.dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #9aa39a;
  flex-shrink: 0;
}

.option.on .dot {
  background: #14202b;
  border-color: #14202b;
}

.option-text {
  flex: 1;
  line-height: 1.4;
}

.submit {
  margin-top: 24rpx;
}

.done {
  margin-top: 28rpx;
  color: #6d7883;
  font-size: 26rpx;
  text-align: center;
}

.results {
  margin-top: 48rpx;
}

.result-meta {
  color: #6d7883;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.result-row {
  margin-bottom: 20rpx;
}

.result-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  gap: 16rpx;
}

.bar {
  height: 12rpx;
  background: #e5e1d8;
  border-radius: 8rpx;
  overflow: hidden;
}

.fill {
  height: 100%;
  background: #14202b;
}

.voters {
  margin-top: 36rpx;
  padding-top: 8rpx;
}

.voter-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(20, 32, 43, 0.08);
}

.voter-row:last-child {
  border-bottom: none;
}

.voter-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #14202b;
}

.voter-meta {
  font-size: 22rpx;
  color: #6d7883;
}

.state {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.state-text {
  color: #8a8378;
  font-size: 26rpx;
}

.state-action {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #14202b;
  letter-spacing: 2rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(20, 32, 43, 0.16);
  border-radius: 999rpx;
}

.press {
  opacity: 0.65;
}
