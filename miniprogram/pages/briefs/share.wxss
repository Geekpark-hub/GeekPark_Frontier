.reader-wrap {
  position: relative;
  height: 100vh;
  background: #f7f5f1;
  overflow: hidden;
}
.reader {
  height: 100vh;
  background: #f7f5f1;
  box-sizing: border-box;
}

.watermark {
  position: fixed;
  left: -24%;
  top: -16%;
  width: 150%;
  height: 140%;
  z-index: 20;
  pointer-events: none;
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  transform: rotate(-24deg);
  opacity: 0.07;
}
.wm-item {
  width: 50%;
  padding: 100rpx 16rpx;
  box-sizing: border-box;
  font-size: 34rpx;
  color: #14202b;
  text-align: center;
  white-space: nowrap;
  letter-spacing: 2rpx;
  font-weight: 500;
}

.sheet {
  position: relative;
  z-index: 1;
  padding: 56rpx 48rpx calc(200rpx + env(safe-area-inset-bottom));
  opacity: 0;
  transform: translateY(12rpx);
  transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}
.sheet.is-ready {
  opacity: 1;
  transform: translateY(0);
}

.mast {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 48rpx;
  padding: 4rpx 0;
}
.mast-press {
  opacity: 0.45;
}
.mast-brand {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #8a8378;
  font-weight: 500;
}
.mast-line {
  flex: 1;
  height: 1rpx;
  background: rgba(20, 32, 43, 0.12);
}
.mast-tag {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #8a8378;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #14202b;
  line-height: 1.38;
  letter-spacing: 0.5rpx;
}
.hero-meta {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #6d7883;
  letter-spacing: 0.5rpx;
}
.hero-dot {
  margin: 0 10rpx;
  color: #c2bbb0;
}

.notice {
  margin-top: 36rpx;
  padding: 24rpx 0 0;
}
.notice-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #8a8378;
  letter-spacing: 0.3rpx;
}

.divider {
  margin: 44rpx 0 8rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(20, 32, 43, 0.14), transparent);
}

.article {
  padding-top: 8rpx;
}

.part {
  margin: 64rpx 0 28rpx;
}
.part-label {
  display: block;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: #9a9286;
  font-weight: 500;
  margin-bottom: 16rpx;
  font-family: "Helvetica Neue", "PingFang SC", sans-serif;
  text-transform: uppercase;
}
.part-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #14202b;
  line-height: 1.42;
  letter-spacing: 0.4rpx;
}

.heading {
  margin: 56rpx 0 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #14202b;
  line-height: 1.45;
}

.para {
  margin: 0 0 36rpx;
  font-size: 32rpx;
  line-height: 1.95;
  color: #2a3340;
  text-align: justify;
  text-indent: 2em;
  letter-spacing: 0.6rpx;
}

.quote {
  position: relative;
  margin: 44rpx 0 48rpx;
  padding: 8rpx 8rpx 8rpx 28rpx;
  border-left: 3rpx solid rgba(20, 32, 43, 0.18);
}
.quote-mark {
  position: absolute;
  left: 20rpx;
  top: -8rpx;
  font-size: 64rpx;
  line-height: 1;
  color: rgba(20, 32, 43, 0.12);
  font-family: Georgia, "Times New Roman", serif;
}
.quote-body {
  font-size: 30rpx;
  line-height: 1.85;
  color: #4a4338;
  letter-spacing: 0.4rpx;
  text-indent: 0;
}

.run-bold {
  font-weight: 600;
  color: #14202b;
}

.end {
  margin-top: 72rpx;
  padding-top: 8rpx;
  text-align: center;
}
.end-mark {
  color: #c2bbb0;
  font-size: 28rpx;
  letter-spacing: 8rpx;
}
.end-text {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9a9286;
  letter-spacing: 4rpx;
}

.state {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f7f5f1;
}
.state-text {
  color: #8a8378;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}
.state-action {
  margin-top: 24rpx;
  color: #14202b;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

/* —— 顶部氛围进度 —— */
.ambient {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 28;
  height: 3rpx;
  background: rgba(20, 32, 43, 0.05);
  opacity: 0;
  transition: opacity 0.35s ease;
  pointer-events: none;
}
.ambient.on {
  opacity: 1;
}
.ambient-fill {
  height: 100%;
  background: linear-gradient(90deg, #2a3340, #14202b);
  transition: width 0.1s linear;
}

/* —— 底部控制岛 —— */
.island {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: #141c24;
  box-shadow:
    0 18rpx 48rpx rgba(20, 32, 43, 0.22),
    0 1rpx 0 rgba(255, 255, 255, 0.06) inset;
  opacity: 0;
  transform: translateY(36rpx) scale(0.96);
  pointer-events: none;
  transition:
    opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}
.island.on {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}
.island-press {
  transform: translateY(2rpx) scale(0.985) !important;
  opacity: 0.92 !important;
}

.island-mark {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 1rpx solid rgba(244, 241, 234, 0.14);
  background: rgba(244, 241, 234, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(244, 241, 234, 0.88);
  letter-spacing: 0;
  font-family: Georgia, "Times New Roman", serif;
}

.island-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.island-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.island-kicker {
  font-size: 18rpx;
  letter-spacing: 2.5rpx;
  color: rgba(244, 241, 234, 0.42);
}
.island-cta {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #f4f1ea;
  font-weight: 500;
}
.island-rail {
  height: 4rpx;
  border-radius: 4rpx;
  background: rgba(244, 241, 234, 0.12);
  overflow: hidden;
}
.island-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, rgba(244, 241, 234, 0.35), #f4f1ea);
  transition: width 0.1s linear;
}
.island-chapter {
  font-size: 24rpx;
  line-height: 1.3;
  color: rgba(244, 241, 234, 0.72);
  letter-spacing: 0.3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* —— Contents：升起 → 标题/条目错落 → 选中轻点反馈 —— */
.dim {
  position: fixed;
  inset: 0;
  z-index: 40;
  background: rgba(20, 32, 43, 0);
  pointer-events: none;
  transition: background 0.48s cubic-bezier(0.32, 0.72, 0, 1);
}
.dim.on {
  background: rgba(20, 32, 43, 0.38);
  pointer-events: auto;
}

.contents {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  max-height: 74vh;
  display: flex;
  flex-direction: column;
  padding: 0 0 calc(16rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #f7f5f1;
  transform: translate3d(0, 108%, 0) scale(0.985);
  opacity: 0.96;
  transition:
    transform 0.52s cubic-bezier(0.32, 0.72, 0, 1),
    opacity 0.28s ease;
  box-shadow: 0 -24rpx 64rpx rgba(20, 32, 43, 0.18);
}
.contents.on {
  transform: translate3d(0, 0, 0) scale(1);
  opacity: 1;
}

.contents-grab {
  width: 56rpx;
  height: 8rpx;
  margin: 14rpx auto 4rpx;
  border-radius: 8rpx;
  background: rgba(20, 32, 43, 0.12);
}

.contents-head {
  padding: 24rpx 44rpx 28rpx;
  opacity: 0;
  transform: translateY(12rpx);
}
.contents.ready .contents-head {
  animation: headIn 0.46s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
@keyframes headIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.contents-head-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}
.contents-title {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  color: #14202b;
  line-height: 1.15;
}
.contents-meta {
  font-size: 24rpx;
  color: #9a9286;
  letter-spacing: 1rpx;
}
.contents-now {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a8378;
  letter-spacing: 0.3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contents-list {
  flex: 1;
  height: 0;
  min-height: 260rpx;
  max-height: 54vh;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.contents-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 30rpx 20rpx;
  border-radius: 18rpx;
  opacity: 0;
  transform: translateY(18rpx);
  transition: background 0.22s ease, transform 0.22s ease;
}
.contents.ready .contents-row {
  animation: contentsIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
@keyframes contentsIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.contents-row-press {
  background: rgba(20, 32, 43, 0.04);
}
.contents-row.pick {
  background: rgba(20, 32, 43, 0.06);
  transform: scale(0.985);
}
.contents-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  margin-left: 14rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #c2bbb0;
  transition: background 0.25s ease, transform 0.25s ease;
}
.contents-row.on .contents-dot {
  background: #14202b;
  transform: scale(1.15);
}
.contents-row-index {
  flex-shrink: 0;
  width: 44rpx;
  padding-top: 4rpx;
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
  color: #c2bbb0;
  font-variant-numeric: tabular-nums;
  transition: color 0.25s ease;
}
.contents-row-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  line-height: 1.4;
  color: rgba(42, 51, 64, 0.48);
  letter-spacing: 0.2rpx;
  transition: color 0.25s ease;
}
.contents-row.on .contents-row-index {
  color: #14202b;
}
.contents-row.on .contents-row-title {
  color: #14202b;
  font-weight: 600;
}

.contents-pad {
  height: 32rpx;
}
