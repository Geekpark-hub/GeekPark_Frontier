.sub-page {
  padding-bottom: 48rpx;
}

.create-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #14202b;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.create-arrow {
  font-size: 34rpx;
  line-height: 1;
  opacity: 0.7;
}

.card {
  background: #fff;
  border: 1rpx solid rgba(20, 32, 43, 0.08);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.row {
  margin-bottom: 12rpx;
}

.chip {
  display: inline-block;
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(20, 32, 43, 0.14);
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #14202b;
  letter-spacing: 1rpx;
}

.content {
  font-size: 28rpx;
  line-height: 1.65;
  color: #14202b;
}

.meta {
  margin-top: 12rpx;
  color: #6d7883;
  font-size: 24rpx;
  line-height: 1.5;
}

.state {
  min-height: 40vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-text {
  color: #8a8378;
  font-size: 26rpx;
}

.state-action {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #14202b;
  letter-spacing: 2rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(20, 32, 43, 0.16);
  border-radius: 999rpx;
}

.empty-block {
  padding: 100rpx 32rpx;
  text-align: center;
}

.empty-title {
  font-size: 28rpx;
  color: #14202b;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9a9286;
  line-height: 1.6;
}

.press {
  opacity: 0.65;
}
