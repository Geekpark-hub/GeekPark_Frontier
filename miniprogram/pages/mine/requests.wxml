<view class="container sub-page">
  <view class="create-row" bindtap="goCreate" hover-class="press">
    <text>提交需求</text>
    <text class="create-arrow">›</text>
  </view>

  <view class="state" wx:if="{{loading}}">
    <view class="state-text">加载中…</view>
  </view>

  <block wx:elif="{{error}}">
    <view class="state">
      <view class="state-text">{{error}}</view>
      <view class="state-action" bindtap="retry" hover-class="press">重试</view>
    </view>
  </block>

  <block wx:else>
    <view wx:for="{{items}}" wx:key="id" class="card">
      <view class="row">
        <view class="chip">{{statusText[item.status] || item.status}}</view>
      </view>
      <view class="content">{{item.content}}</view>
      <view class="meta" wx:if="{{item.location}}">地点：{{item.location}}</view>
      <view class="meta" wx:if="{{item.connectWith}}">希望连接：{{item.connectWith}}</view>
    </view>
    <view wx:if="{{!items.length}}" class="empty-block">
      <view class="empty-title">暂无需求记录</view>
      <view class="empty-desc">提交后可在这里查看处理进度</view>
    </view>
  </block>
</view>
