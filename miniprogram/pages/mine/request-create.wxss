.field {
  margin-bottom: 28rpx;
}

.label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.label {
  color: #3f474d;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.req-tag {
  display: inline-flex;
  align-items: center;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #fff;
  background: #14202b;
  line-height: 1;
}

.opt-tag {
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #a39b8f;
  line-height: 1;
}

.textarea {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--ink);
  min-height: 200rpx;
  line-height: 1.55;
}

.textarea.is-required {
  border-color: rgba(20, 32, 43, 0.28);
  box-shadow: 0 0 0 2rpx rgba(20, 32, 43, 0.04);
}

.textarea.is-short {
  min-height: 100rpx;
}

.err-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b42318;
  letter-spacing: 0.5rpx;
}
