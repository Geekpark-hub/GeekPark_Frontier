.field {
  margin-bottom: 24rpx;
}

.label {
  margin-bottom: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.input,
.textarea {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--ink);
  min-height: 88rpx;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.arrow {
  color: #9aa39a;
  font-size: 36rpx;
}

.textarea {
  min-height: 220rpx;
}
