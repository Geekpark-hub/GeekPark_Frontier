.sub-page {
  padding-bottom: 48rpx;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.chip {
  display: inline-block;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(20, 32, 43, 0.14);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #14202b;
  letter-spacing: 1rpx;
}

.time {
  font-size: 22rpx;
  color: #9a9286;
  letter-spacing: 0.5rpx;
}

.block {
  margin-bottom: 28rpx;
  padding: 28rpx;
  background: #fff;
  border: 1rpx solid rgba(20, 32, 43, 0.08);
  border-radius: 16rpx;
}

.label {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #9a9286;
  letter-spacing: 1rpx;
}

.body {
  font-size: 30rpx;
  line-height: 1.7;
  color: #14202b;
  white-space: pre-wrap;
  word-break: break-word;
}

.body.soft {
  font-size: 28rpx;
  color: #3f474d;
}

.state {
  min-height: 50vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-text {
  color: #8a8378;
  font-size: 26rpx;
}

.state-action {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #14202b;
  letter-spacing: 2rpx;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(20, 32, 43, 0.16);
  border-radius: 999rpx;
}

.press {
  opacity: 0.65;
}
