.mine-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.profile {
  position: relative;
  margin-bottom: 28rpx;
  padding: 36rpx 8rpx 28rpx;
  overflow: hidden;
}

/* 肌理弱到几乎看不见，仔细看才有 */
.texture {
  position: absolute;
  inset: -20rpx;
  pointer-events: none;
  opacity: 0.022;
  background-image:
    linear-gradient(90deg, #14202b 1rpx, transparent 1rpx),
    linear-gradient(#14202b 1rpx, transparent 1rpx),
    linear-gradient(135deg, transparent 48%, #14202b 49%, #14202b 50%, transparent 51%);
  background-size: 52rpx 52rpx, 52rpx 52rpx, 104rpx 104rpx;
}

.profile-en {
  position: relative;
  font-size: 18rpx;
  letter-spacing: 5rpx;
  color: #9a9286;
  margin-bottom: 14rpx;
}

.name {
  position: relative;
  font-size: 48rpx;
  font-weight: 650;
  color: #14202b;
  letter-spacing: 3rpx;
  line-height: 1.2;
}

.line {
  position: relative;
  margin-top: 14rpx;
  color: #6d7883;
  font-size: 26rpx;
  line-height: 1.5;
}

.expire {
  position: relative;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9a9286;
  letter-spacing: 1rpx;
}

.badge {
  position: relative;
  margin-top: 22rpx;
  display: inline-block;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(20, 32, 43, 0.18);
  border-radius: 999rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #14202b;
  background: rgba(255, 255, 255, 0.55);
}

.meta-block {
  margin-bottom: 20rpx;
  padding: 24rpx 26rpx;
  background: #fff;
  border: 1rpx solid rgba(20, 32, 43, 0.08);
  border-radius: 16rpx;
}

.phone {
  font-size: 26rpx;
  color: #14202b;
}

.links {
  margin-top: 12rpx;
}

.link-line {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6d7883;
  word-break: break-all;
}

.link-line.tap {
  color: #4a5560;
  text-decoration: underline;
  text-decoration-color: rgba(20, 32, 43, 0.18);
  text-underline-offset: 4rpx;
}

.menu {
  background: #fff;
  border: 1rpx solid rgba(20, 32, 43, 0.08);
  border-radius: 16rpx;
  padding: 8rpx 0;
  overflow: hidden;
}

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 28rpx;
  font-size: 28rpx;
  color: #3a424a;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #14202b;
  opacity: 0.55;
}

.item .arrow {
  color: #c4bbb0;
  font-size: 34rpx;
  line-height: 1;
}

.item.accent {
  color: #14202b;
  font-weight: 500;
}

.item.accent .arrow {
  color: #14202b;
}

.press {
  opacity: 0.65;
}

.logout {
  margin-top: auto;
  padding-top: 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b0a89c;
  letter-spacing: 2rpx;
}
