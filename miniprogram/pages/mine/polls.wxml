<view class="container sub-page">
  <view class="state" wx:if="{{loading}}">
    <view class="state-text">加载中…</view>
  </view>

  <block wx:elif="{{error}}">
    <view class="state">
      <view class="state-text">{{error}}</view>
      <view class="state-action" bindtap="retry" hover-class="press">重试</view>
    </view>
  </block>

  <block wx:else>
    <view
      wx:for="{{items}}"
      wx:key="poll.id"
      class="card"
      data-id="{{item.poll.id}}"
      bindtap="goDetail"
      hover-class="press"
    >
      <view class="title">{{item.poll.title}}</view>
      <view class="meta">我的选择：{{item.optionText || '—'}}</view>
      <view class="meta soft" wx:if="{{item.endLabel}}">截止 {{item.endLabel}}</view>
    </view>
    <view wx:if="{{!items.length}}" class="empty-block">
      <view class="empty-title">暂无投票记录</view>
      <view class="empty-desc">参与动态里的投票后，记录会出现在这里</view>
    </view>
  </block>
</view>
