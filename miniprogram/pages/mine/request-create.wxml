<view class="container" wx:if="{{allowed}}">
  <view class="field">
    <view class="label-row">
      <text class="label">需求内容</text>
      <text class="req-tag">必填</text>
    </view>
    <textarea
      class="textarea is-required"
      placeholder="描述你的需求场景"
      value="{{form.content}}"
      bindinput="onInput"
      data-key="content"
      maxlength="2000"
      auto-height
    />
    <view class="err-tip" wx:if="{{contentError}}">请先填写需求内容后再提交</view>
  </view>

  <view class="field">
    <view class="label-row">
      <text class="label">时间</text>
      <text class="opt-tag">选填</text>
    </view>
    <textarea
      class="textarea is-short"
      placeholder="如 下周 / 3月下旬 / 灵活 / 待定"
      value="{{form.time}}"
      bindinput="onInput"
      data-key="time"
      maxlength="200"
      auto-height
    />
  </view>

  <view class="field">
    <view class="label-row">
      <text class="label">地点</text>
      <text class="opt-tag">选填</text>
    </view>
    <textarea
      class="textarea is-short"
      placeholder="如 San Francisco / Singapore"
      value="{{form.location}}"
      bindinput="onInput"
      data-key="location"
      maxlength="200"
      auto-height
    />
  </view>

  <view class="field">
    <view class="label-row">
      <text class="label">希望连接的人 / 资源</text>
      <text class="opt-tag">选填</text>
    </view>
    <textarea
      class="textarea"
      placeholder="如 AI Founder, Investor"
      value="{{form.connectWith}}"
      bindinput="onInput"
      data-key="connectWith"
      maxlength="1000"
      auto-height
    />
  </view>

  <button class="btn-primary" bindtap="submit">提交</button>
</view>
