<view class="gate" wx:if="{{visible}}">
  <image class="gate-bg" src="/assets/brand/atmosphere.jpg" mode="aspectFill" />
  <view class="gate-veil"></view>
  <view class="grain"></view>

  <view class="stage">
    <view class="logo-row">
      <text class="logo-en">THE FRONT</text>
      <text class="logo-bar">|</text>
      <text class="logo-en">ER</text>
    </view>
    <view class="brand">前沿社</view>
    <image class="exploring" src="/assets/brand/exploring.png" mode="widthFix" />
    <view class="tagline">开启认知新可能</view>

    <block wx:if="{{mode === 'inactive'}}">
      <view class="headline">会员状态待处理</view>
      <view class="desc">{{message || '会员状态暂不可用，请联系前沿社运营。'}}</view>
    </block>

    <block wx:elif="{{mode === 'notMember'}}">
      <view class="headline">{{blockedHeadline}}</view>
      <view class="desc">{{message || '请联系前沿社运营处理。'}}</view>
      <input
        class="invite-input"
        type="nickname"
        placeholder="点击选用微信昵称"
        placeholder-class="invite-ph"
        value="{{nickname}}"
        bindinput="onNickInput"
        bindblur="onNickBlur"
        bindconfirm="onNickBlur"
      />
      <button
        class="cta"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        hover-class="cta-hover"
        loading="{{submitting}}"
        disabled="{{!canSubmit || submitting}}"
      >
        确认进入
      </button>
      <view class="cta-hint">将请求手机号授权，可选择拒绝，不影响进入</view>
    </block>

    <block wx:else>
      <view class="headline">欢迎来到前沿社</view>
      <view class="desc">{{message || '点选微信昵称后确认进入；将请求手机号授权，可拒绝。'}}</view>
      <input
        class="invite-input"
        type="nickname"
        placeholder="点击选用微信昵称"
        placeholder-class="invite-ph"
        value="{{nickname}}"
        bindinput="onNickInput"
        bindblur="onNickBlur"
        bindconfirm="onNickBlur"
      />
      <button
        class="cta"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        hover-class="cta-hover"
        loading="{{submitting}}"
        disabled="{{!canSubmit || submitting}}"
      >
        确认进入
      </button>
      <view class="cta-hint">点输入框可选微信昵称；确认时会拉起手机号，可拒绝</view>
    </block>
  </view>
</view>
