.gate {
  position: relative;
  min-height: 100vh;
  padding: 0 44rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background: #0a0a0a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: gate-in 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.gate-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.55;
  animation: kenburns 20s ease-in-out infinite alternate;
}

.gate-veil {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.62) 42%, rgba(0, 0, 0, 0.9) 100%);
}

.grain {
  position: absolute;
  inset: 0;
  opacity: 0.08;
  background-image:
    radial-gradient(rgba(255, 255, 255, 0.35) 0.6rpx, transparent 0.6rpx);
  background-size: 6rpx 6rpx;
  pointer-events: none;
}

.stage {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 640rpx;
  text-align: center;
  animation: rise 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.logo-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
}

.logo-en {
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.logo-bar {
  color: rgba(255, 255, 255, 0.35);
  font-size: 22rpx;
}

.brand {
  margin-top: 14rpx;
  font-size: 64rpx;
  font-weight: 650;
  letter-spacing: 18rpx;
  color: #fff;
  line-height: 1.1;
  text-indent: 18rpx;
}

.exploring {
  display: block;
  width: 88%;
  max-width: 560rpx;
  margin: 40rpx auto 0;
  opacity: 0.96;
  animation: soft-in 1000ms ease 160ms both;
}

.tagline {
  margin-top: 18rpx;
  font-size: 22rpx;
  letter-spacing: 8rpx;
  color: rgba(255, 255, 255, 0.55);
}

.headline {
  margin-top: 56rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  letter-spacing: 3rpx;
}

.desc {
  margin: 16rpx auto 0;
  max-width: 520rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 25rpx;
  line-height: 1.75;
}

.phone {
  margin-top: 28rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
  color: #fff;
}

.cta {
  margin: 48rpx 0 0;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  background: #fff;
  color: #0a0a0a;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
}

.cta::after {
  border: none;
}

.cta-hover {
  opacity: 0.88;
  transform: scale(0.985);
}

.cta-hint {
  margin-top: 18rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 2rpx;
}

.cta-hint.soft {
  margin-top: 28rpx;
  margin-bottom: -12rpx;
}

@keyframes gate-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes rise {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes soft-in {
  from { opacity: 0; transform: translateY(14rpx) scale(0.97); }
  to { opacity: 0.96; transform: translateY(0) scale(1); }
}

@keyframes kenburns {
  from { transform: scale(1.06); }
  to { transform: scale(1.14) translate3d(-1.5%, 1%, 0); }
}
