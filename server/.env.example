DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=3000

# 微信
WX_APPID=
WX_SECRET=
# 微信订阅消息模板 ID（公众平台申请；关键词字段须与下表一致，否则发送失败）
# 到期（会员权益到期通知）：time1 签约 / time2 到期 / thing3 类型 / thing4 剩余 / thing5 账号
WX_SUBSCRIBE_TEMPLATE_EXPIRY=
# 兼容旧变量名（等同 EXPIRY）
WX_SUBSCRIBE_TEMPLATE_ID=
# 报名成功（活动报名成功通知）：thing1 活动名 / time2 活动时间 / time3 开始时间 / thing4 地址 / thing5 备注
WX_SUBSCRIBE_TEMPLATE_REGISTER=
# 活动开始提醒：thing1 活动名 / time2 开始时间 / thing3 地点 / thing4 嘉宾 / thing5 介绍
WX_SUBSCRIBE_TEMPLATE_EVENT_REMIND=
# formal | trial | developer
# WX_SUBSCRIBE_STATE=formal


# 飞书推送二选一（或都配：有应用配置时优先卡片内批准/拒绝）
# A) 自定义机器人 Webhook：仅支持按钮跳转网页
FEISHU_WEBHOOK_URL=
# B) 应用机器人（推荐）：点按钮原地更新卡片，需开放平台自建应用
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_CHAT_ID=                 # 运营群 chat_id（oc_xxx），应用机器人需已进群
# FEISHU_VERIFICATION_TOKEN=      # 事件订阅 Verification Token
# 回调地址填：https://frontier-api.geekpark.net/api/feishu/card
# 订阅回调：card.action.trigger（卡片回传交互）
# 飞书卡片「批准/拒绝」链接的公网 API 根地址（Webhook 跳转兼容）
PUBLIC_API_BASE=https://frontier-api.geekpark.net
# 每次 AI 抓取最多往群里推几条待审卡（默认 8，最大 20）
FEISHU_FEED_PUSH_LIMIT=8
# 可选：批准/拒绝签名密钥（默认回退 JWT_SECRET）
# FEISHU_ACTION_SECRET=

# 七牛云对象存储（配齐后管理端封面上传走 CDN；不配则回退本地 /uploads）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
# 区域：z0 华东 / z1 华北 / z2 华南 / cn-east-2 华东-浙江2
QINIU_ZONE=z1
QINIU_PREFIX=frontier/

# 调试 mock 登录（默认关闭；正式环境务必 false / 不配）
ALLOW_MOCK_LOGIN=false

# 定时任务
ENABLE_JOBS=true
CRON_MAINTENANCE="5 * * * *"
CRON_AI_FEED="30 8 * * *"
CRON_RSS_INGEST="20 */4 * * *"
AI_FEED_DAYS=30
# 每人每轮最多写入待审条数（定时/手动默认 10，最大 15）
AI_FEED_LIMIT_PER_MEMBER=10
# AI 抓取并发：会员并行数 × 每人候选并行数（默认 8×5）
AI_FEED_MEMBER_CONCURRENCY=8
AI_FEED_ITEM_CONCURRENCY=5
# RSS 本地档案保留天数（默认比 AI_FEED_DAYS 多 7 天）
RSS_RETENTION_DAYS=37

# 搜索 API（三选一；不配则 mock）
# SEARCH_PROVIDER=tavily|serper|mock
TAVILY_API_KEY=
SERPER_API_KEY=
# 兼容别名
SEARCH_API_KEY=

# 大模型（OpenAI 兼容；不配则 mock）
# LLM_PROVIDER=openai|mock
# Modelink 示例：
MODELINK_API_KEY=
LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.modelink.ai/v1
LLM_MODEL=deepseek/deepseek-v4-pro
# LLM_JSON_MODE=true
