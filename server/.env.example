DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=3000

# 微信
WX_APPID=
WX_SECRET=
# 可选：会员到期订阅消息模板 ID
WX_SUBSCRIBE_TEMPLATE_ID=

# 飞书群机器人 Webhook（会员提交需求时推送；不配则跳过）
FEISHU_WEBHOOK_URL=

# 调试 mock 登录（默认关闭；正式环境务必 false / 不配）
ALLOW_MOCK_LOGIN=false

# 定时任务
ENABLE_JOBS=true
CRON_MAINTENANCE="5 * * * *"
CRON_AI_FEED="30 8 * * *"
AI_FEED_DAYS=30

# 搜索 API（三选一；不配则 mock）
# SEARCH_PROVIDER=tavily|serper|mock
TAVILY_API_KEY=
SERPER_API_KEY=
# 兼容别名
SEARCH_API_KEY=

# 大模型（OpenAI 兼容；不配则 mock）
# LLM_PROVIDER=openai|mock
# Modelink 示例：
MODELINK_API_KEY=
LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.modelink.ai/v1
LLM_MODEL=deepseek/deepseek-v4-pro
# LLM_JSON_MODE=true
